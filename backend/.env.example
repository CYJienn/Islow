APP_NAME=Kaunter API
ENVIRONMENT=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Multi-agent orchestration
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FINANCE_WORKBOOK=
FINANCE_INVOICE_INPUT_DIR=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kaunter-local

# GrowthLab marketing uses GOOGLE_API_KEY and GEMINI_MODEL above
DEFAULT_RESEARCH_MODE=demo
SENTIMENT_MODEL_PATH=./ml/model/growthlab-sentiment-yelp-tuned
SENTIMENT_MODEL_SOURCE=hub
SENTIMENT_MODEL_ID=KaiHuang05/growthlab-sentiment-yelp-tuned
TAVILY_API_KEY=
MAX_REVIEWS=200
MAX_SEARCH_QUERIES=3
MAX_SEARCH_RESULTS=5
LLM_TIMEOUT_SECONDS=45
MARKETING_API_TOKEN=

# Optional for private Hugging Face model downloads; required for upload unless `hf auth login` was used.
HF_TOKEN=
